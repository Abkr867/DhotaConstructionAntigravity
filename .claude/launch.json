{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "D:/DhotaConstruction/backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--app-dir",
        "D:/DhotaConstruction/backend",
        "--port",
        "8003"
      ],
      "port": 8003,
      "autoPort": false,
      "env": {
        "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/DhotaConstruction/frontend",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "REACT_APP_BACKEND_URL": "http://localhost:8003",
        "BROWSER": "none"
      }
    }
  ]
}